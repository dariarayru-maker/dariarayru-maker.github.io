---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const base = import.meta.env.BASE_URL;
const { post } = Astro.props;
const { Content } = await render(post);

const segmentLabel: Record<string, string> = {
  smb: 'Малый и средний бизнес',
  b2b: 'B2B',
  general: 'Общее',
};

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.segment === post.data.segment)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Дарья Дегтярева' },
  url: new URL(`${base}blog/${post.id}/`, Astro.site).href,
};
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <Breadcrumbs items={[
    { label: 'Главная', href: base },
    { label: 'Блог', href: `${base}blog/` },
    { label: segmentLabel[post.data.segment] },
    { label: post.data.title },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16">
    <span class="font-mono text-xs uppercase tracking-wide text-signal">
      {segmentLabel[post.data.segment]} · {post.data.category}
    </span>
    <h1 class="mt-3 font-display text-3xl font-medium text-ink sm:text-4xl">{post.data.title}</h1>
    <time class="mt-4 block font-mono text-xs text-ink-soft/50" datetime={post.data.pubDate.toISOString()}>
      {post.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
    </time>

    <div class="prose prose-slate max-w-none mt-8 prose-headings:font-display prose-headings:font-medium prose-headings:text-ink prose-a:text-signal">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-16">
      <h2 class="font-mono text-xs uppercase tracking-wide text-ink-soft/50 border-t border-line/60 pt-8 mb-4">
        Похожие статьи · {segmentLabel[post.data.segment]}
      </h2>
      <ul class="space-y-3">
        {related.map((p) => (
          <li>
            <a href={`${base}blog/${p.id}/`} class="font-display font-medium text-ink hover:text-signal">
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CTASection
    title="Узнайте, как это работает для вашего бизнеса"
    description="Оставьте заявку на бесплатную диагностику — разберём вашу ситуацию за 30 минут."
  />
</BaseLayout>
