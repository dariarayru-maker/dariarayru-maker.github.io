---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const base = import.meta.env.BASE_URL;
const { post } = Astro.props;
const { Content } = await render(post);

const segmentLabel: Record<string, string> = {
  smb: 'Малый и средний бизнес',
  b2b: 'B2B',
  general: 'Общее',
};

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.segment === post.data.segment)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <Breadcrumbs items={[
    { label: 'Главная', href: base },
    { label: 'Блог', href: `${base}blog/` },
    { label: segmentLabel[post.data.segment] },
    { label: post.data.title },
  ]} />

  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16">
    <span class="text-xs font-semibold uppercase tracking-wide text-amber-600">
      {segmentLabel[post.data.segment]} · {post.data.category}
    </span>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mt-3 mb-4">{post.data.title}</h1>
    <time class="text-sm text-slate-400" datetime={post.data.pubDate.toISOString()}>
      {post.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
    </time>

    <div class="prose prose-slate max-w-none mt-8 prose-headings:font-bold prose-a:text-amber-600">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-16">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 border-t border-slate-200 pt-8 mb-4">
        Похожие статьи · {segmentLabel[post.data.segment]}
      </h2>
      <ul class="space-y-3">
        {related.map((p) => (
          <li>
            <a href={`${base}blog/${p.id}/`} class="font-medium text-slate-900 hover:text-amber-600">
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CTASection
    title="Узнайте, как это работает для вашего бизнеса"
    description="Оставьте заявку на бесплатную диагностику — разберём вашу ситуацию за 20 минут."
  />
</BaseLayout>
