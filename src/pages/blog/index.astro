---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const title = 'Блог об антикризисном маркетинге';
const description =
  'Статьи об антикризисном маркетинге для малого, среднего и B2B-бизнеса: падение продаж, рост стоимости лида, защита бюджета, перестройка каналов привлечения.';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const segmentLabel: Record<string, string> = {
  smb: 'Малый и средний бизнес',
  b2b: 'B2B',
  general: 'Общее',
};
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Главная', href: base }, { label: 'Блог' }]} />

  <section class="mx-auto max-w-6xl px-4 pt-10 pb-10">
    <h1 class="font-display text-4xl font-medium text-ink">Блог</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft/80">
      Статьи о том, как бизнесу сохранять продажи и маркетинговый бюджет
      в нестабильной экономике — отдельно для малого/среднего бизнеса и для B2B.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="grid gap-x-10 gap-y-10 border-b border-line/60 sm:grid-cols-2 lg:grid-cols-3">
      {allPosts.map((post) => (
        <a href={`${base}blog/${post.id}/`} class="group block border-t border-line/60 pt-6">
          <span class="font-mono text-xs uppercase tracking-wide text-signal">
            {segmentLabel[post.data.segment]} · {post.data.category}
          </span>
          <h2 class="mt-2 font-display text-lg font-medium text-ink group-hover:text-signal">{post.data.title}</h2>
          <p class="mt-3 text-sm text-ink-soft/80">{post.data.description}</p>
          <time class="mt-4 block font-mono text-xs text-ink-soft/50" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </a>
      ))}
    </div>
  </section>

  <CTASection
    title="Узнали свою ситуацию в одной из статей?"
    description="Оставьте заявку на бесплатную диагностику — разберём вашу ситуацию за 30 минут."
  />
</BaseLayout>
