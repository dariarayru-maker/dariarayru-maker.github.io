---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const title = 'Блог об антикризисном маркетинге';
const description =
  'Статьи об антикризисном маркетинге для малого, среднего и B2B-бизнеса: падение продаж, рост стоимости лида, защита бюджета, перестройка каналов привлечения.';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const segmentLabel: Record<string, string> = {
  smb: 'Малый и средний бизнес',
  b2b: 'B2B',
  general: 'Общее',
};
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10">
    <h1 class="text-4xl font-extrabold tracking-tight mb-4">Блог</h1>
    <p class="text-lg text-slate-600 max-w-2xl">
      Статьи о том, как бизнесу сохранять продажи и маркетинговый бюджет
      в нестабильной экономике — отдельно для малого/среднего бизнеса и для B2B.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {allPosts.map((post) => (
      <a
        href={`${base}blog/${post.id}/`}
        class="block rounded-2xl border border-slate-200 p-6 hover:border-amber-500 hover:shadow-lg transition-all bg-white"
      >
        <span class="text-xs font-semibold uppercase tracking-wide text-amber-600">
          {segmentLabel[post.data.segment]} · {post.data.category}
        </span>
        <h2 class="text-lg font-bold mt-2 mb-2">{post.data.title}</h2>
        <p class="text-slate-600 text-sm mb-3">{post.data.description}</p>
        <time class="text-xs text-slate-400" datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </a>
    ))}
  </section>
</BaseLayout>
