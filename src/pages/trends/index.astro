---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const title = 'Тренды маркетинга';
const description =
  'Разбор трендов маркетинга и продвижения: ИИ, рекламные платформы, каналы продаж, данные — что реально меняет правила игры для бизнеса, а что хайп.';

const allTrends = (await getCollection('trends', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Главная', href: base }, { label: 'Тренды' }]} />

  <section class="mx-auto max-w-6xl px-4 pt-10 pb-10">
    <h1 class="font-display text-4xl font-medium text-ink">Тренды маркетинга</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft/80">
      Разбор того, что реально меняет маркетинг прямо сейчас — без привязки к конкретной
      дате и без хайпа: что стоит учитывать в стратегии, а что можно пропустить.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="grid gap-x-10 gap-y-10 border-b border-line/60 sm:grid-cols-2 lg:grid-cols-3">
      {allTrends.map((item) => (
        <a href={`${base}trends/${item.id}/`} class="group block border-t border-line/60 pt-6">
          <span class="font-mono text-xs uppercase tracking-wide text-signal">
            {item.data.category}
          </span>
          <h2 class="mt-2 font-display text-lg font-medium text-ink group-hover:text-signal">{item.data.title}</h2>
          <p class="mt-3 text-sm text-ink-soft/80">{item.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <CTASection
    title="Не уверены, какой из трендов реально касается вашего бизнеса?"
    description="Оставьте заявку на бесплатную диагностику — разберём вашу ситуацию за 30 минут."
  />
</BaseLayout>
