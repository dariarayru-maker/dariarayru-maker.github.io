---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const title = 'Тренды маркетинга';
const description =
  'Разбор трендов маркетинга и продвижения: ИИ, рекламные платформы, каналы продаж, данные — что реально меняет правила игры для бизнеса, а что хайп.';

const allTrends = (await getCollection('trends', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Главная', href: base }, { label: 'Тренды' }]} />

  <section class="mx-auto max-w-6xl px-4 pt-10 pb-10">
    <h1 class="text-4xl font-extrabold tracking-tight mb-4">Тренды маркетинга</h1>
    <p class="text-lg text-slate-600 max-w-2xl">
      Разбор того, что реально меняет маркетинг прямо сейчас — без привязки к конкретной
      дате и без хайпа: что стоит учитывать в стратегии, а что можно пропустить.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {allTrends.map((item) => (
      <a
        href={`${base}trends/${item.id}/`}
        class="block rounded-2xl border border-slate-200 p-6 hover:border-amber-500 hover:shadow-lg transition-all bg-white"
      >
        <span class="text-xs font-semibold uppercase tracking-wide text-amber-600">
          {item.data.category}
        </span>
        <h2 class="text-lg font-bold mt-2 mb-2">{item.data.title}</h2>
        <p class="text-slate-600 text-sm">{item.data.description}</p>
      </a>
    ))}
  </section>
</BaseLayout>
