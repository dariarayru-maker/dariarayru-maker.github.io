---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('trends', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const base = import.meta.env.BASE_URL;
const { item } = Astro.props;
const { Content } = await render(item);

const allTrends = await getCollection('trends', ({ data }) => !data.draft);
const related = allTrends
  .filter((t) => t.id !== item.id && t.data.category === item.data.category)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'))
  .slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.data.title,
  description: item.data.description,
  datePublished: item.data.pubDate.toISOString(),
  dateModified: (item.data.updatedDate ?? item.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Дарья Дегтярева' },
  url: new URL(`${base}trends/${item.id}/`, Astro.site).href,
};
---

<BaseLayout title={item.data.title} description={item.data.description} type="article">
  <Breadcrumbs items={[
    { label: 'Главная', href: base },
    { label: 'Тренды', href: `${base}trends/` },
    { label: item.data.category },
    { label: item.data.title },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16">
    <span class="block font-mono text-xs uppercase tracking-wide text-signal">
      {item.data.category}
    </span>
    <h1 class="mt-3 font-display text-3xl font-medium text-ink sm:text-4xl">{item.data.title}</h1>
    <time class="mt-4 block font-mono text-xs text-ink-soft/50" datetime={item.data.pubDate.toISOString()}>
      {item.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
    </time>

    <div class="prose prose-slate max-w-none mt-8 prose-headings:font-display prose-headings:font-medium prose-headings:text-ink prose-a:text-signal">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-16">
      <h2 class="font-mono text-xs uppercase tracking-wide text-ink-soft/50 border-t border-line/60 pt-8 mb-4">
        Похожие темы · {item.data.category}
      </h2>
      <ul class="space-y-3">
        {related.map((t) => (
          <li>
            <a href={`${base}trends/${t.id}/`} class="font-display font-medium text-ink hover:text-signal">
              {t.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CTASection
    title="Нужно применить это к своему бизнесу?"
    description="Оставьте заявку на бесплатную диагностику — разберём вашу ситуацию за 30 минут."
  />
</BaseLayout>
