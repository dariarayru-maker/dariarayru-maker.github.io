---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const title = 'Глоссарий маркетинга';
const description =
  'Справочник терминов маркетинга: определения, виды, инструменты, организация отдела маркетинга и обучение — простыми словами.';

const allTerms = (await getCollection('glossary', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title, 'ru')
);

const categoryOrder = [
  'Основы и определения',
  'Виды маркетинга',
  'Структура и инструменты',
  'Для бизнеса',
  'Образование и карьера',
];

const grouped = new Map<string, typeof allTerms>();
for (const term of allTerms) {
  const list = grouped.get(term.data.category) ?? [];
  list.push(term);
  grouped.set(term.data.category, list);
}

const categories = [...grouped.keys()].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10">
    <h1 class="text-4xl font-extrabold tracking-tight mb-4">Глоссарий маркетинга</h1>
    <p class="text-lg text-slate-600 max-w-2xl">
      Термины, виды и инструменты маркетинга простыми словами — справочник для тех, кто
      изучает маркетинг, работает в нём или выбирает подрядчика.
    </p>
  </section>

  {categories.map((category) => (
    <section class="mx-auto max-w-6xl px-4 pb-14">
      <h2 class="text-xl font-bold text-slate-900 mb-4 border-b border-slate-200 pb-2">{category}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {grouped.get(category)!.map((term) => (
          <a
            href={`${base}glossary/${term.id}/`}
            class="block rounded-xl border border-slate-200 p-5 hover:border-amber-500 hover:shadow-md transition-all bg-white"
          >
            <h3 class="font-semibold text-slate-900 mb-1">{term.data.title}</h3>
            <p class="text-sm text-slate-600">{term.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
