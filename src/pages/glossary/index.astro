---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const title = 'Глоссарий маркетинга';
const description =
  'Справочник терминов маркетинга: определения, виды, инструменты, организация отдела маркетинга и обучение — простыми словами.';

const allTerms = (await getCollection('glossary', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title, 'ru')
);

const categoryOrder = [
  'Основы и определения',
  'Виды маркетинга',
  'Структура и инструменты',
  'Для бизнеса',
  'Образование и карьера',
];

const grouped = new Map<string, typeof allTerms>();
for (const term of allTerms) {
  const list = grouped.get(term.data.category) ?? [];
  list.push(term);
  grouped.set(term.data.category, list);
}

const categories = [...grouped.keys()].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Главная', href: base }, { label: 'Глоссарий' }]} />

  <section class="mx-auto max-w-6xl px-4 pt-10 pb-10">
    <h1 class="font-display text-4xl font-medium text-ink">Глоссарий маркетинга</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft/80">
      Термины, виды и инструменты маркетинга простыми словами — справочник для тех, кто
      изучает маркетинг, работает в нём или выбирает подрядчика.
    </p>
  </section>

  {categories.map((category) => (
    <section class="mx-auto max-w-6xl px-4 pb-14">
      <h2 class="font-mono text-xs uppercase tracking-wide text-ink-soft/50 border-b border-line/60 pb-3 mb-6">{category}</h2>
      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {grouped.get(category)!.map((term) => (
          <a href={`${base}glossary/${term.id}/`} class="group block border-t border-line/60 pt-5">
            <h3 class="font-display font-medium text-ink group-hover:text-signal">{term.data.title}</h3>
            <p class="mt-2 text-sm text-ink-soft/80">{term.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <CTASection
    title="Не нашли нужный термин или не понимаете, как это применить у себя?"
    description="Оставьте заявку на бесплатную диагностику — разберём вашу ситуацию за 30 минут."
  />
</BaseLayout>
