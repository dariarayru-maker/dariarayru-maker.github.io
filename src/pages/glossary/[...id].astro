---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const terms = await getCollection('glossary', ({ data }) => !data.draft);
  return terms.map((term) => ({
    params: { id: term.id },
    props: { term },
  }));
}

const base = import.meta.env.BASE_URL;
const { term } = Astro.props;
const { Content } = await render(term);

const allTerms = await getCollection('glossary', ({ data }) => !data.draft);
const related = allTerms
  .filter((t) => t.id !== term.id && t.data.category === term.data.category)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'))
  .slice(0, 5);

const termSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term.data.title,
  description: term.data.description,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'Глоссарий маркетинга — Дарья Дегтярева',
    url: new URL(`${base}glossary/`, Astro.site).href,
  },
  url: new URL(`${base}glossary/${term.id}/`, Astro.site).href,
};
---

<BaseLayout title={term.data.title} description={term.data.description} type="article">
  <Breadcrumbs items={[
    { label: 'Главная', href: base },
    { label: 'Глоссарий', href: `${base}glossary/` },
    { label: term.data.category },
    { label: term.data.title },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(termSchema)} />

  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16">
    <span class="block font-mono text-xs uppercase tracking-wide text-signal">
      {term.data.category}
    </span>
    <h1 class="mt-3 font-display text-3xl font-medium text-ink sm:text-4xl">{term.data.title}</h1>

    <div class="prose prose-slate max-w-none mt-8 prose-headings:font-display prose-headings:font-medium prose-headings:text-ink prose-a:text-signal">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-16">
      <h2 class="font-mono text-xs uppercase tracking-wide text-ink-soft/50 border-t border-line/60 pt-8 mb-4">
        Термины рядом · {term.data.category}
      </h2>
      <ul class="space-y-3">
        {related.map((t) => (
          <li>
            <a href={`${base}glossary/${t.id}/`} class="font-display font-medium text-ink hover:text-signal">
              {t.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CTASection
    title="Нужно применить это на практике в своём бизнесе?"
    description="Оставьте заявку на бесплатную диагностику — разберём вашу ситуацию за 30 минут."
  />
</BaseLayout>
