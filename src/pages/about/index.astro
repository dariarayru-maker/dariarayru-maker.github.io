---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';

const base = import.meta.env.BASE_URL;

const title = 'Обо мне';
const description = 'Daria Ray — growth-маркетолог с опытом перестройки маркетинга для бизнеса в нестабильной экономике.';

const stats = [
  { value: '8+', label: 'лет в growth-маркетинге' },
  { value: '5+', label: 'стран, где запускались проекты' },
  { value: '×4', label: 'рост выручки на падающем рынке' },
  { value: '2', label: 'сегмента: SMB и B2B' },
];
---

<BaseLayout title={title} description={description}>
  <div class="relative h-64 overflow-hidden bg-ink sm:h-80">
    <img
      src={`${base}images/facade.webp`}
      alt="Фасад здания с ровной сеткой окон — структура и дисциплина вместо хаоса"
      class="h-full w-full object-cover opacity-70 mix-blend-luminosity"
    />
    <div class="absolute inset-0 bg-ink/40"></div>
    <p class="absolute bottom-6 left-4 right-4 mx-auto max-w-6xl font-mono text-xs text-paper/70 sm:left-1/2 sm:-translate-x-1/2">
      Сначала структура, потом стратегия
    </p>
  </div>

  <section class="mx-auto max-w-3xl px-4 pb-16 pt-14">
    <h1 class="font-display text-4xl font-medium text-ink">Daria Ray</h1>
    <p class="mt-6 text-lg text-ink-soft/80">
      Я growth-маркетолог с опытом построения систем роста для digital- и mobile-продуктов:
      acquisition → activation → retention → monetization. Последние годы фокусируюсь на
      антикризисной перестройке маркетинга — когда привычные каналы дорожают или перестают
      работать, а бизнесу нужно не потерять продажи здесь и сейчас.
    </p>

    <dl class="mt-10 grid grid-cols-2 gap-y-8 border-t border-line/60 pt-6 sm:grid-cols-4">
      {stats.map((stat) => (
        <div>
          <dt class="font-mono text-2xl text-ink">{stat.value}</dt>
          <dd class="mt-1 text-xs text-ink-soft/70">{stat.label}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-10 text-ink-soft/80">
      Работаю проектно и на подписке, удалённо. Подробнее о форматах работы — на странице{' '}
      <a href={`${base}services/`} class="text-ink underline decoration-line underline-offset-4 hover:decoration-signal hover:text-signal">
        услуг
      </a>.
    </p>
  </section>

  <CTASection
    title="Расскажите о своей ситуации"
    description="Отвечу, какой формат работы подойдёт вам лучше всего."
  />
</BaseLayout>
