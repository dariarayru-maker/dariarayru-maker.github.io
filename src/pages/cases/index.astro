---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import CTASection from '../../components/CTASection.astro';

const title = 'Кейсы';
const description =
  'Результаты проектов по росту и антикризисной перестройке маркетинга для малого, среднего и B2B-бизнеса.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10">
    <h1 class="text-4xl font-extrabold tracking-tight mb-4">Кейсы</h1>
    <p class="text-lg text-slate-600 max-w-2xl">
      Результаты по проектам разных сегментов — от перезапуска без рекламного бюджета
      до снижения стоимости заявки в B2B.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 grid sm:grid-cols-2 gap-6">
    <CaseCard
      segment="smb"
      title="Эксперт на образовательном рынке"
      before="250 тыс ₽/мес"
      after="5,3 млн ₽/мес"
      description="Маркетинговая стратегия и перестройка воронки для эксперта без штатной команды маркетинга."
    />
    <CaseCard
      segment="smb"
      title="Онлайн-школа профессий"
      before="5 млн ₽/мес"
      after="15 млн ₽/мес"
      description="Рост выручки в 3 раза за счёт диверсификации каналов привлечения и пересборки воронки."
    />
    <CaseCard
      segment="smb"
      title="Запуск онлайн-продукта"
      before="300 тыс ₽"
      after="1,7 млн ₽"
      description="Запуск нового продукта с ограниченным бюджетом и быстрым выходом на окупаемость."
    />
    <CaseCard
      segment="smb"
      title="Продукт для специалиста без рекламного бюджета"
      before="0 ₽"
      after="400 тыс ₽/мес"
      description="Выход на выручку за счёт органики и партнёрств — без платного трафика."
    />
    <CaseCard
      segment="b2b"
      title="B2B-продвижение услуг"
      before="высокий CPL"
      after="выручка ×4"
      description="Снижение стоимости заявки до 300 ₽ при росте выручки в 4 раза за счёт пересборки воронки и каналов."
    />
    <CaseCard
      segment="b2b"
      title="Международный запуск продукта"
      before="1 рынок"
      after="5+ стран"
      description="Запуск продукта и программы лояльности в нескольких странах с разными каналами привлечения."
    />
  </section>

  <CTASection
    title="Хотите похожий результат в своей нише?"
    description="Расскажите о бизнесе — оценю, с чего стоит начать именно вам."
  />
</BaseLayout>
