---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const title = 'Кейсы';
const description =
  'Результаты проектов по росту и антикризисной перестройке маркетинга для малого, среднего и B2B-бизнеса.';
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Главная', href: base }, { label: 'Кейсы' }]} />

  <section class="mx-auto max-w-6xl px-4 pt-10 pb-10">
    <h1 class="text-4xl font-extrabold tracking-tight mb-4">Кейсы</h1>
    <p class="text-lg text-slate-600 max-w-2xl">
      Результаты по проектам разных сегментов — от перезапуска без рекламного бюджета
      до снижения стоимости заявки в B2B.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 grid sm:grid-cols-2 gap-6">
    <CaseCard
      segment="smb"
      title="Эксперт на образовательном рынке"
      before="250 тыс ₽/мес"
      after="5,3 млн ₽/мес"
      description="Маркетинговая стратегия и перестройка воронки для эксперта без штатной команды маркетинга."
    />
    <CaseCard
      segment="smb"
      title="Онлайн-школа профессий"
      before="5 млн ₽/мес"
      after="15 млн ₽/мес"
      description="Рост выручки в 3 раза за счёт диверсификации каналов привлечения и пересборки воронки. NPS по курсу вырос с 6,9 до 9,8."
    />
    <CaseCard
      segment="smb"
      title="Запуск онлайн-продукта"
      before="300 тыс ₽"
      after="1,7 млн ₽"
      description="Запуск нового продукта с ограниченным бюджетом и быстрым выходом на окупаемость. NPS 9,7."
    />
    <CaseCard
      segment="smb"
      title="Маркетинговая стратегия на тёплую базу"
      before="243 тыс ₽"
      after="1,54 млн ₽"
      description="Рост выручки в 6 раз без привлечения нового трафика — только работа с уже собранной базой."
    />
    <CaseCard
      segment="smb"
      title="Запуск через вебинар для предпринимателя"
      before="8,6 тыс ₽ бюджета"
      after="235 тыс ₽ продаж"
      description="ROAS 27× на холодном трафике: от объявления до оплаты — воронка вебинар → заказ → продажа."
    />
    <CaseCard
      segment="smb"
      title="Продукт для специалиста без рекламного бюджета"
      before="0 ₽"
      after="400 тыс ₽/мес"
      description="Выход на выручку за счёт органики и партнёрств — без платного трафика."
    />
    <CaseCard
      segment="smb"
      title="Набор аудитории в Telegram-канал"
      before="0 подписчиков"
      after="39 998 подписчиков"
      description="Через Telegram Ads — база почти 40 тысяч человек за 2 месяца по 160 ₽ за подписчика."
    />
    <CaseCard
      segment="smb"
      title="Продвижение и продажа билетов QUEEN SHOW"
      before="0 билетов"
      after="349 билетов"
      description="Продвижение концертного тура через Яндекс.Поиск, РСЯ и ВК — 6000+ зрителей в 6 городах."
    />
    <CaseCard
      segment="b2b"
      title="B2B-продвижение услуг"
      before="высокий CPL"
      after="выручка ×4"
      description="Снижение стоимости заявки до 300 ₽ при росте выручки в 4 раза за счёт пересборки воронки и каналов."
    />
    <CaseCard
      segment="b2b"
      title="Лидогенерация для застройщика на Бали"
      before="без системной лидогенерации"
      after="~400 лидов/мес"
      description="Системная лидогенерация для одного из крупнейших застройщиков острова на постоянной основе."
    />
    <CaseCard
      segment="b2b"
      title="Международный запуск продукта"
      before="1 рынок"
      after="5+ стран"
      description="Запуск продукта и программы лояльности в нескольких странах с разными каналами привлечения."
    />
  </section>

  <CTASection
    title="Хотите похожий результат в своей нише?"
    description="Расскажите о бизнесе — оценю, с чего стоит начать именно вам."
  />
</BaseLayout>
