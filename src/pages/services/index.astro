---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const title = 'Услуги антикризисного маркетинга';
const description =
  'Антикризисный аудит маркетинга, антикризисная стратегия и ведение маркетинга на подписке для малого, среднего и B2B-бизнеса.';
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Главная', href: base }, { label: 'Услуги' }]} />

  <section class="mx-auto max-w-6xl px-4 pt-10 pb-6">
    <h1 class="text-4xl font-extrabold tracking-tight mb-4">Услуги</h1>
    <p class="text-lg text-slate-600 max-w-2xl">
      Две независимые вещи определяют, что вам нужно: <strong>формат работы</strong> —
      сколько сделать мне, сколько вам — и <strong>ваш сегмент</strong>, который задаёт
      содержание. Любой формат подходит обоим сегментам.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-10">
    <div class="overflow-x-auto rounded-xl border border-slate-200">
      <table class="w-full text-sm text-left">
        <thead class="bg-slate-50 text-slate-500 uppercase text-xs">
          <tr>
            <th class="px-4 py-3">Формат → / Сегмент ↓</th>
            <th class="px-4 py-3">Аудит<br /><span class="normal-case font-normal text-amber-600">Бесплатно · 30 мин</span></th>
            <th class="px-4 py-3">Стратегия<br /><span class="normal-case font-normal text-amber-600">45 000 ₽</span></th>
            <th class="px-4 py-3">Ведение на подписке<br /><span class="normal-case font-normal text-amber-600">от 100 000 ₽/мес</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="px-4 py-3 font-semibold">
              <a href={`${base}services/smb/`} class="text-amber-600 hover:text-amber-700">Малый и средний бизнес</a>
            </td>
            <td class="px-4 py-3 text-slate-600">Находим, что держит продажи</td>
            <td class="px-4 py-3 text-slate-600">План на 1–3 месяца без лишнего бюджета</td>
            <td class="px-4 py-3 text-slate-600">Веду маркетинг вместо штатного маркетолога</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold">
              <a href={`${base}services/b2b/`} class="text-amber-600 hover:text-amber-700">B2B и средний бизнес</a>
            </td>
            <td class="px-4 py-3 text-slate-600">Аргументы для разговора о бюджете</td>
            <td class="px-4 py-3 text-slate-600">План снижения CAC и защиты бюджета</td>
            <td class="px-4 py-3 text-slate-600">Ежемесячная отчётность перед руководством</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-4">
    <h2 class="text-2xl font-bold">Что входит в каждый формат</h2>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 grid sm:grid-cols-3 gap-6">
    <ServiceCard
      href={`${base}services/audit/`}
      step="01 · 30 минут"
      title="Антикризисный аудит маркетинга"
      description="Звонок-диагностика воронки, каналов и экономики. Результат — список проблем и точек роста с приоритетами."
      price="бесплатно"
    />
    <ServiceCard
      href={`${base}services/strategy/`}
      step="02 · 2-4 недели"
      title="Антикризисная стратегия"
      description="План действий на 1-3 месяца: что сократить, что усилить, как перестроить воронку и бюджет."
      price="45 000 ₽"
    />
    <ServiceCard
      href={`${base}services/retainer/`}
      step="03 · ежемесячно"
      title="Ведение маркетинга"
      description="Беру маркетинг на себя: внедряю стратегию, тестирую гипотезы, отчитываюсь по метрикам каждый месяц."
      price="от 100 000 ₽/мес"
    />
  </section>

  <CTASection
    title="Сомневаетесь, какой формат нужен?"
    description="Расскажите о ситуации — предложу формат, с которого стоит начать именно вам."
  />
</BaseLayout>
