---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const title = 'Ведение маркетинга на подписке';
const description =
  'Ежемесячное ведение маркетинга: внедряю антикризисную стратегию, тестирую гипотезы роста, отчитываюсь по метрикам. Для бизнеса без штатного маркетолога.';
---

<BaseLayout title={title} description={description} type="article">
  <Breadcrumbs items={[
    { label: 'Главная', href: base },
    { label: 'Услуги', href: `${base}services/` },
    { label: 'Ведение на подписке' },
  ]} />

  <section class="mx-auto max-w-3xl px-4 pt-10 pb-10">
    <p class="text-amber-600 font-semibold mb-3">Шаг 3 · от 100 000 ₽/мес</p>
    <h1 class="text-4xl font-extrabold tracking-tight mb-5">Ведение маркетинга на подписке</h1>
    <p class="text-lg text-slate-600">
      Стратегия без внедрения остаётся документом в столе. Беру маркетинг на себя: веду
      каналы, тестирую гипотезы, корректирую план по ходу месяца и отчитываюсь
      по цифрам — без необходимости держать штатного маркетолога или агентство.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-10">
    <h2 class="text-2xl font-bold mb-4">Что входит каждый месяц</h2>
    <ul class="space-y-3 text-slate-700">
      <li>— Ведение и оптимизация рекламных каналов и воронки</li>
      <li>— Еженедельные гипотезы роста и их тестирование</li>
      <li>— Контроль юнит-экономики: CAC, ROMI, стоимость заявки</li>
      <li>— Ежемесячный отчёт с цифрами и планом на следующий месяц</li>
      <li>— Быстрая реакция на изменения рынка — блокировки, рост цен, падение спроса</li>
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-10">
    <h2 class="text-2xl font-bold mb-4">Кому подходит</h2>
    <p class="text-slate-700">
      Бизнесу, который прошёл этап{' '}
      <a href={`${base}services/strategy/`} class="font-semibold text-amber-600 hover:text-amber-700">диагностики и планирования</a>
      и хочет, чтобы маркетингом занимался человек с опытом, а не нанимать и обучать
      штатную команду в нестабильное время — будь то{' '}
      <a href={`${base}services/smb/`} class="font-semibold text-amber-600 hover:text-amber-700">малый и средний бизнес</a>
      или <a href={`${base}services/b2b/`} class="font-semibold text-amber-600 hover:text-amber-700">B2B</a>.
    </p>
  </section>

  <CTASection
    title="Хотите, чтобы маркетингом занимались без вашего постоянного контроля?"
    description="Расскажите о бизнесе — предложу формат подписки и первые шаги."
  />
</BaseLayout>
