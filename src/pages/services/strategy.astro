---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const title = 'Антикризисная стратегия маркетинга';
const description =
  'План на 1-3 месяца: что сократить, что усилить и как перестроить воронку и бюджет, чтобы продажи не упали вместе с рынком.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  description,
  provider: { '@type': 'Person', name: 'Дарья Дегтярева' },
  offers: { '@type': 'Offer', price: '45000', priceCurrency: 'RUB' },
  url: new URL(`${base}services/strategy/`, Astro.site).href,
};
---

<BaseLayout title={title} description={description} type="article">
  <Breadcrumbs items={[
    { label: 'Главная', href: base },
    { label: 'Услуги', href: `${base}services/` },
    { label: 'Антикризисная стратегия' },
  ]} />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <section class="mx-auto max-w-3xl px-4 pt-10 pb-10">
    <p class="text-signal font-semibold mb-3">Шаг 2 · 45 000 ₽ · 2-4 недели</p>
    <h1 class="font-display text-4xl font-medium text-ink mb-5">Антикризисная стратегия</h1>
    <p class="text-lg text-ink-soft/80">
      Аудит показывает, что болит. Стратегия — что делать дальше: конкретный план
      на 1-3 месяца с приоритетами, сроками и ответом на вопрос "откуда возьмутся заявки,
      если старый канал подорожал или исчез".
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-10">
    <h2 class="font-display text-2xl font-medium text-ink mb-4">Что входит</h2>
    <ul class="space-y-3 text-ink-soft/80">
      <li>— Пересборка воронки под текущий спрос и бюджет</li>
      <li>— План диверсификации каналов, если бизнес держится на одном источнике лидов</li>
      <li>— Приоритизация: что сократить без потери продаж, что усилить для быстрого результата</li>
      <li>— Антикризисные гипотезы роста с оценкой сроков и ресурсов на внедрение</li>
      <li>— Метрики и контрольные точки, по которым видно, работает план или нет</li>
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-10">
    <h2 class="font-display text-2xl font-medium text-ink mb-4">Кому подходит</h2>
    <p class="text-ink-soft/80">
      Бизнесу, у которого уже есть диагноз (свой или по итогам{' '}
      <a href={`${base}services/audit/`} class="font-semibold text-signal hover:text-signal/80">аудита</a>)
      и который готов действовать: нужен конкретный план, а не общие рекомендации
      "улучшить SEO и таргет". Подходит и{' '}
      <a href={`${base}services/smb/`} class="font-semibold text-signal hover:text-signal/80">малому и среднему бизнесу</a>,
      и <a href={`${base}services/b2b/`} class="font-semibold text-signal hover:text-signal/80">B2B</a> —
      план строится под конкретную ситуацию, а не по шаблону.
    </p>
  </section>

  <p class="mx-auto max-w-3xl px-4 pb-6 text-sm text-ink-soft/60">
    Ещё не уверены, что именно нужно? Начните с{' '}
    <a href={`${base}services/audit/`} class="font-semibold text-signal hover:text-signal/80">бесплатного 30-минутного аудита</a> —
    по его итогам станет понятно, нужна ли стратегия вообще.
  </p>

  <CTASection
    title="Нужен план, а не набор советов?"
    description="Оставьте заявку — обсудим ситуацию и сроки разработки стратегии."
  />
</BaseLayout>
