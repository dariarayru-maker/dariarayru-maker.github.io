---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const base = import.meta.env.BASE_URL;
const title = 'Антикризисный аудит маркетинга';
const description =
  'Разбираю маркетинг и продажи за 1-2 недели: что в кризис держит выручку, что стало балластом, и с чего начать, чтобы не терять бюджет дальше.';
---

<BaseLayout title={title} description={description} type="article">
  <Breadcrumbs items={[
    { label: 'Главная', href: base },
    { label: 'Услуги', href: `${base}services/` },
    { label: 'Антикризисный аудит' },
  ]} />

  <section class="mx-auto max-w-3xl px-4 pt-10 pb-10">
    <p class="text-amber-600 font-semibold mb-3">Шаг 1 · разовая услуга</p>
    <h1 class="text-4xl font-extrabold tracking-tight mb-5">Антикризисный аудит маркетинга</h1>
    <p class="text-lg text-slate-600">
      Когда продажи падают, а причина непонятна — первая ошибка в кризис это резать бюджет
      наугад или, наоборот, бездействовать. Аудит даёт точный диагноз: что в воронке и
      каналах реально держит продажи, а что уже не окупается.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-10">
    <h2 class="text-2xl font-bold mb-4">Что входит в аудит</h2>
    <ul class="space-y-3 text-slate-700">
      <li>— Разбор воронки продаж: где теряются заявки и деньги</li>
      <li>— Аудит рекламных каналов и их реальной юнит-экономики (CAC, ROMI, LTV)</li>
      <li>— Проверка, не зависит ли бизнес от одного канала, который могут заблокировать или резко поднять в цене</li>
      <li>— Оценка контента и позиционирования: соответствуют ли они текущему спросу</li>
      <li>— Список точек роста и рисков с приоритетами — что чинить первым</li>
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-10">
    <h2 class="text-2xl font-bold mb-4">Кому подходит</h2>
    <p class="text-slate-700">
      <a href={`${base}services/smb/`} class="font-semibold text-amber-600 hover:text-amber-700">Малому и среднему бизнесу</a> —
      когда продажи упали и непонятно почему, а штатного маркетолога нет.{' '}
      <a href={`${base}services/b2b/`} class="font-semibold text-amber-600 hover:text-amber-700">B2B-компаниям</a> —
      когда нужно показать руководству объективную картину перед тем, как защищать или сокращать бюджет.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16">
    <h2 class="text-2xl font-bold mb-4">Результат</h2>
    <p class="text-slate-700">
      Документ с диагнозом, приоритизированным списком проблем и точек роста, и
      рекомендацией — двигаться дальше самостоятельно, заказать антикризисную
      стратегию или перейти на ведение маркетинга на подписке.
    </p>
  </section>

  <CTASection
    title="Узнайте, что на самом деле держит ваши продажи"
    description="Оставьте заявку — уточню детали по вашему бизнесу и сроки аудита."
  />
</BaseLayout>
