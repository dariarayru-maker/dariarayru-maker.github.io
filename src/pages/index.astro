---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseCard from '../components/CaseCard.astro';
import CTASection from '../components/CTASection.astro';

const base = import.meta.env.BASE_URL;

const title = 'Антикризисный маркетинг для бизнеса — Дарья Дегтярева';
const description =
  'Аудит, антикризисная стратегия и ведение маркетинга на подписке для малого, среднего и B2B-бизнеса: сохраняем продажи и защищаем бюджет, когда спрос падает, а стоимость лида растёт.';

const triggers = [
  'Продажи упали, а почему — непонятно',
  'Реклама дорожает, бюджет урезали, а план не снизили',
  'Площадка или канал продвижения заблокирован либо подорожал в разы',
  'Нужно за 1–3 месяца показать руководству рост или экономию',
  'Нет своего маркетолога, но без заявок бизнес не выживет',
];

const stats = [
  { value: '8+', label: 'лет в growth-маркетинге' },
  { value: '5+', label: 'стран, где запускались проекты' },
  { value: '×4', label: 'рост выручки на падающем рынке' },
];
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto grid max-w-6xl gap-12 px-4 pb-16 pt-14 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:pt-20">
    <div>
      <p class="text-sm text-ink-soft/70">Антикризисный маркетинг для бизнеса</p>
      <h1 class="mt-4 max-w-xl font-display text-4xl font-medium leading-[1.1] tracking-tight text-ink sm:text-5xl">
        Маркетинг не падает вместе с рынком
      </h1>
      <p class="mt-6 max-w-md text-lg text-ink-soft/80">
        Помогаю малому, среднему и B2B-бизнесу перестроить маркетинг, когда спрос падает, цена лида
        растёт или рекламный бюджет режут: нахожу, что в воронке держит продажи, а что в кризис
        стало балластом.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`${base}services/audit/`}
          class="border border-ink bg-ink px-6 py-3 font-medium text-paper transition-colors hover:bg-signal hover:border-signal"
        >
          Заказать антикризисный аудит
        </a>
        <a
          href={`${base}services/`}
          class="border border-line px-6 py-3 font-medium text-ink transition-colors hover:border-ink"
        >
          Все услуги
        </a>
      </div>

      <dl class="mt-12 grid max-w-md grid-cols-3 divide-x divide-line/60 border-t border-line/60 pt-6">
        {stats.map((stat) => (
          <div class="px-4 first:pl-0">
            <dt class="font-mono text-2xl text-ink">{stat.value}</dt>
            <dd class="mt-1 text-xs text-ink-soft/70">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="bg-ink p-6 text-paper sm:p-8">
      <svg viewBox="0 0 400 190" class="w-full" role="img" aria-labelledby="chart-title">
        <title id="chart-title">Рынок падает, график выручки клиента выравнивается и растёт</title>
        <line x1="0" y1="52" x2="400" y2="52" stroke="#3a4051" stroke-width="1" />
        <line x1="0" y1="110" x2="400" y2="110" stroke="#3a4051" stroke-width="1" />
        <line x1="222" y1="8" x2="222" y2="168" stroke="#565c6e" stroke-width="1" stroke-dasharray="3 4" />

        <path d="M0,38 C 55,52 95,88 150,118 C 175,134 200,146 222,150" fill="none" stroke="#e0603e" stroke-width="2.5" stroke-linecap="round" />
        <path d="M222,150 C 238,146 265,126 295,112 C 335,94 370,86 400,84" fill="none" stroke="#56b78a" stroke-width="2.5" stroke-linecap="round" />

        <circle cx="222" cy="150" r="3.5" fill="#eceae1" />

        <text x="0" y="24" font-family="IBM Plex Mono, monospace" font-size="11" fill="#9aa0b0">рынок</text>
        <text x="222" y="183" font-family="IBM Plex Mono, monospace" font-size="11" fill="#9aa0b0" text-anchor="middle">сегодня</text>
        <text x="400" y="74" font-family="IBM Plex Mono, monospace" font-size="11" fill="#9aa0b0" text-anchor="end">ваш маркетинг</text>
      </svg>

      <p class="mt-6 font-mono text-xs text-paper/50">Когда обращаются за антикризисным маркетингом</p>
      <ul class="mt-3 divide-y divide-paper/10 border-t border-paper/10">
        {triggers.map((item) => (
          <li class="py-3 text-sm text-paper/85">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="max-w-xl font-display text-2xl font-medium text-ink sm:text-3xl">
      Три шага от диагноза до результата
    </h2>
    <p class="mt-3 max-w-xl text-ink-soft/80">
      Начинаем с аудита — без него антикризисные решения превращаются в угадайку.
    </p>
    <div class="mt-8 border-b border-line/60">
      <ServiceCard
        href={`${base}services/audit/`}
        step="01"
        title="Антикризисный аудит маркетинга"
        description="Разбираем воронку, каналы и юнит-экономику: что держит продажи и что уже не работает."
        price="1–2 недели"
      />
      <ServiceCard
        href={`${base}services/strategy/`}
        step="02"
        title="Антикризисная стратегия"
        description="План на 1–3 месяца: что сократить, что усилить, как защитить маржу и заявки."
        price="2–4 недели"
      />
      <ServiceCard
        href={`${base}services/retainer/`}
        step="03"
        title="Ведение маркетинга на подписке"
        description="Внедряю стратегию и веду маркетинг каждый месяц: метрики, гипотезы, отчётность."
        price="ежемесячно"
      />
    </div>
  </section>

  <div class="relative h-56 overflow-hidden bg-ink sm:h-72">
    <img
      src={`${base}images/market-chart.webp`}
      alt="Графики котировок на тёмном терминале"
      class="h-full w-full object-cover opacity-60 mix-blend-luminosity"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/50 to-ink/10"></div>
    <p class="absolute bottom-6 left-4 max-w-sm font-mono text-xs text-paper/70 sm:left-1/2 sm:-translate-x-[calc(50%-1.5rem)]">
      Решения на падающем рынке принимают по данным, а не по ощущениям
    </p>
  </div>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">Для кого</h2>
    <div class="mt-8 grid gap-10 border-t border-line/60 pt-8 sm:grid-cols-2">
      <a href={`${base}services/smb/`} class="group">
        <h3 class="font-display text-xl font-medium text-ink group-hover:text-signal">Малый и средний бизнес</h3>
        <p class="mt-3 text-ink-soft/80">
          Локальный бизнес, услуги, розница — когда нет штатного маркетолога и бюджета на агентство,
          а заявки нужны уже сейчас.
        </p>
      </a>
      <a href={`${base}services/b2b/`} class="group">
        <h3 class="font-display text-xl font-medium text-ink group-hover:text-signal">B2B и средний бизнес</h3>
        <p class="mt-3 text-ink-soft/80">
          Длинный цикл сделки, маркетинг-директор должен обосновать бюджет перед руководством
          и снизить стоимость заявки.
        </p>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">
      Результаты на падающем и нестабильном рынке
    </h2>
    <div class="mt-8 grid gap-x-10 border-b border-line/60 sm:grid-cols-2">
      <CaseCard
        segment="smb"
        title="Эксперт на образовательном рынке"
        before="250 тыс ₽/мес"
        after="5,3 млн ₽/мес"
        description="Маркетинговая стратегия и перестройка воронки для эксперта без штатной команды."
      />
      <CaseCard
        segment="b2b"
        title="B2B-продвижение услуг"
        before="высокий CPL"
        after="выручка ×4"
        description="Снижение стоимости заявки до 300 ₽ при росте выручки в 4 раза."
      />
      <CaseCard
        segment="smb"
        title="Онлайн-школа профессий"
        before="5 млн ₽/мес"
        after="15 млн ₽/мес"
        description="Рост выручки в 3 раза за счёт пересборки каналов привлечения."
      />
      <CaseCard
        segment="smb"
        title="Запуск без рекламного бюджета"
        before="0 ₽"
        after="400 тыс ₽/мес"
        description="Онлайн-продукт вышел на выручку без платного трафика — органика и партнёрства."
      />
    </div>
    <a href={`${base}cases/`} class="mt-6 inline-block font-medium text-ink underline decoration-line underline-offset-4 hover:decoration-signal hover:text-signal">
      Смотреть все кейсы
    </a>
  </section>

  <CTASection
    title="Не знаете, с чего начать антикризисную перестройку?"
    description="Начните с бесплатной 20-минутной диагностики — отвечу, в чём именно у вас сейчас проблема и какой шаг имеет смысл первым."
    ctaLabel="Записаться на диагностику"
  />
</BaseLayout>
