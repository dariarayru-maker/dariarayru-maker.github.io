---
const testimonials = [
  {
    quote:
      'Дарья отличается высоким уровнем самостоятельности, стратегического мышления и проактивности. Она не ограничивается операционным управлением, а мыслит категориями роста, эффективности и долгосрочного развития продукта.',
    author: 'Генеральный директор',
    company: 'WIM, профессиональный CRM-маркетинг',
  },
  {
    quote:
      'Дарья отличается профессионализмом, стратегическим мышлением, умением брать на себя ответственность и доводить задачи до результата. Она легко выстраивает коммуникацию как внутри команды, так и с внешними партнёрами.',
    author: 'Директор диджитал-агентства',
    company: 'Plan B',
  },
  {
    quote:
      'Дарья отличается инициативностью, креативным мышлением и стратегическим подходом к работе. Она умеет видеть картину целиком, при этом оставаясь очень внимательной к деталям.',
    author: 'Директор по маркетингу',
    company: 'агентство CONTRL',
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">Что говорят о работе со мной</h2>
  <p class="mt-3 max-w-xl text-ink-soft/80">Из рекомендательных писем партнёров и руководителей проектов.</p>

  <div class="mt-8 grid gap-8 border-t border-line/60 pt-8 sm:grid-cols-3">
    {testimonials.map((t) => (
      <figure>
        <blockquote class="text-ink-soft/90">
          <p>«{t.quote}»</p>
        </blockquote>
        <figcaption class="mt-4 font-mono text-xs text-ink-soft/60">
          — {t.author}, {t.company}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
