---
interface Props {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const base = import.meta.env.BASE_URL;
const { title, description, ctaLabel = 'Оставить заявку на аудит', ctaHref = `${base}contacts/` } = Astro.props;
---

<section class="bg-slate-900 text-white rounded-3xl mx-4 lg:mx-auto max-w-6xl px-6 py-12 my-16 text-center">
  <h2 class="text-2xl sm:text-3xl font-bold mb-3">{title}</h2>
  <p class="text-slate-300 max-w-2xl mx-auto mb-6">{description}</p>
  <a
    href={ctaHref}
    class="inline-block rounded-full bg-amber-500 text-slate-900 font-semibold px-6 py-3 hover:bg-amber-400 transition-colors"
  >
    {ctaLabel}
  </a>
</section>
