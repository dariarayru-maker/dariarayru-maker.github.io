---
interface Props {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const base = import.meta.env.BASE_URL;
const { title, description, ctaLabel = 'Оставить заявку на аудит', ctaHref = `${base}contacts/` } = Astro.props;
---

<section class="mx-auto my-20 max-w-6xl bg-ink px-6 py-14 text-paper sm:px-10">
  <div class="grid gap-8 lg:grid-cols-[2fr_1fr] lg:items-end">
    <div>
      <h2 class="font-display text-2xl font-medium sm:text-3xl">{title}</h2>
      <p class="mt-3 max-w-xl text-paper/70">{description}</p>
    </div>
    <a
      href={ctaHref}
      class="inline-block border border-paper px-6 py-3 text-center font-mono text-sm text-paper transition-colors hover:bg-signal hover:border-signal"
    >
      {ctaLabel}
    </a>
  </div>
</section>
