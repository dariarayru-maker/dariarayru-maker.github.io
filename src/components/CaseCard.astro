---
interface Props {
  segment: 'smb' | 'b2b';
  title: string;
  before: string;
  after: string;
  description: string;
}

const { segment, title, before, after, description } = Astro.props;
const segmentLabel = segment === 'smb' ? 'Малый/средний бизнес' : 'B2B';
---

<article class="border-t border-line/60 py-7">
  <span class="font-mono text-xs text-ink-soft/50">{segmentLabel}</span>
  <h3 class="mt-2 font-display text-lg font-medium text-ink">{title}</h3>
  <div class="mt-3 flex items-center gap-3 font-mono text-sm">
    <span class="text-signal/80 line-through decoration-signal/40">{before}</span>
    <span class="h-px w-4 bg-line" aria-hidden="true"></span>
    <span class="font-medium text-steady">{after}</span>
  </div>
  <p class="mt-3 text-sm text-ink-soft/80">{description}</p>
</article>
