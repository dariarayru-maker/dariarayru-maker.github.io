---
interface Props {
  href: string;
  step: string;
  title: string;
  description: string;
  price: string;
}

const { href, step, title, description, price } = Astro.props;
---

<a
  href={href}
  class="block rounded-2xl border border-slate-200 p-6 hover:border-amber-500 hover:shadow-lg transition-all bg-white"
>
  <span class="text-xs font-semibold uppercase tracking-wide text-amber-600">{step}</span>
  <h3 class="text-xl font-bold mt-2 mb-2">{title}</h3>
  <p class="text-slate-600 mb-4">{description}</p>
  <p class="font-semibold text-slate-900">{price}</p>
</a>
