---
interface Props {
  href: string;
  step: string;
  title: string;
  description: string;
  price: string;
}

const { href, step, title, description, price } = Astro.props;
---

<a href={href} class="group block border-t border-line/60 py-7 transition-colors hover:border-ink">
  <div class="flex items-baseline justify-between gap-4">
    <span class="font-mono text-sm text-ink-soft/50">{step}</span>
    <span class="font-mono text-sm text-ink-soft/60">{price}</span>
  </div>
  <h3 class="mt-2 font-display text-xl font-medium text-ink group-hover:text-signal">{title}</h3>
  <p class="mt-2 max-w-xl text-ink-soft/80">{description}</p>
</a>
