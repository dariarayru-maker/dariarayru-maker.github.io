---
const base = import.meta.env.BASE_URL;

const nav = [
  { href: `${base}`, label: 'Главная' },
  { href: `${base}services/`, label: 'Услуги' },
  { href: `${base}services/smb/`, label: 'Малому и среднему бизнесу' },
  { href: `${base}services/b2b/`, label: 'B2B' },
  { href: `${base}blog/`, label: 'Блог' },
  { href: `${base}glossary/`, label: 'Глоссарий' },
  { href: `${base}cases/`, label: 'Кейсы' },
  { href: `${base}about/`, label: 'Обо мне' },
];
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href={base} class="font-display text-lg font-semibold tracking-tight text-ink">
      Daria Ray
    </a>

    <nav class="hidden items-center gap-6 text-sm lg:flex">
      {nav.slice(1).map((item) => (
        <a href={item.href} class="text-ink-soft/80 transition-colors hover:text-ink">
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href={`${base}contacts/`}
      class="border border-ink bg-ink px-4 py-2 font-mono text-xs text-paper transition-colors hover:bg-signal hover:border-signal"
    >
      Заявка на аудит
    </a>
  </div>

  <nav class="flex gap-4 overflow-x-auto whitespace-nowrap border-t border-line/40 px-4 py-2.5 text-sm lg:hidden">
    {nav.slice(1).map((item) => (
      <a href={item.href} class="text-ink-soft/80">{item.label}</a>
    ))}
  </nav>
</header>
