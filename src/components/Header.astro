---
const base = import.meta.env.BASE_URL;

const nav = [
  { href: `${base}services/`, label: 'Услуги' },
  { href: `${base}blog/`, label: 'Блог' },
  { href: `${base}glossary/`, label: 'Глоссарий' },
  { href: `${base}cases/`, label: 'Кейсы' },
  { href: `${base}about/`, label: 'Обо мне' },
];
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href={base} class="flex flex-col leading-tight">
      <span class="font-display text-lg font-semibold tracking-tight text-ink">Дарья Дегтярева</span>
      <span class="font-mono text-[11px] text-ink-soft/60">Антикризисный маркетинг</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm lg:flex">
      {nav.map((item) => (
        <a href={item.href} class="text-ink-soft/80 transition-colors hover:text-ink">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={`${base}contacts/`}
        class="hidden border border-ink bg-ink px-4 py-2 font-mono text-xs text-paper transition-colors hover:bg-signal hover:border-signal sm:inline-block"
      >
        Заявка на аудит
      </a>

      <details class="relative lg:hidden">
        <summary class="list-none cursor-pointer border border-line px-3 py-2 font-mono text-xs text-ink">
          Меню
        </summary>
        <nav class="absolute right-0 top-[calc(100%+0.5rem)] w-56 border border-line bg-paper py-2 shadow-lg">
          {nav.map((item) => (
            <a href={item.href} class="block px-4 py-2 text-sm text-ink-soft/80 hover:bg-line/20 hover:text-ink">
              {item.label}
            </a>
          ))}
          <a href={`${base}contacts/`} class="block px-4 py-2 text-sm font-semibold text-signal hover:bg-line/20">
            Заявка на аудит
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
